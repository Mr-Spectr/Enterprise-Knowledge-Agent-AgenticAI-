# Prefer Anthropic for general LLM answers. Keep actual values in a local .env
# file or your deployment secret manager; never commit them.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional fallback when an Anthropic key is not configured.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional: defaults to data/students.csv bundled with the project.
# STUDENT_DB_CSV_PATH=/absolute/path/to/students.csv
