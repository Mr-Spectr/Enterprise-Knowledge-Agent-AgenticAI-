# Prefer Anthropic for general LLM answers. Keep actual values in a local .env
# file or your deployment secret manager; never commit them.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional fallback when an Anthropic key is not configured.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Fast model used for individual agent deliberation traces.
GROQ_AGENT_MODEL=groq/compound-mini

# Optional: defaults to data/students.csv bundled with the project.
# STUDENT_DB_CSV_PATH=/absolute/path/to/students.csv

# Optional: point the agents at an imported Moodle SQLite database.
# A configured database is used as-is and is never overwritten by demo CSV data.
# ACADEMIC_SQLITE_PATH=/absolute/path/to/moodle.sqlite
